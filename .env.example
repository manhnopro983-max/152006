# PostgreSQL (admin user — creates DB and schema)
POSTGRES_DB=expense_tracker
POSTGRES_USER=expense_user
POSTGRES_PASSWORD=change_me_strong_password_123

# App Database User (limited permissions — CRUD only, no DDL)
APP_DB_USER=expense_app
APP_DB_PASSWORD=change_me_app_secure_password

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me_pgadmin_password
PGADMIN_PORT=5050

# App
NODE_ENV=production
PORT=3000

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_grafana_password
